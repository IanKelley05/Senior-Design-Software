# Local Flask server
APP_HOST=127.0.0.1
APP_PORT=5000

# PostgreSQL: fill in your own local database and login; no credentials included.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGCONNECT_TIMEOUT=3

# UDP bind address and port. Use 0.0.0.0 to listen on all laptop interfaces.
# Start the combined web/UDP app with python app.py (reloader disabled).
UDP_HOST=127.0.0.1
UDP_PORT=5005

# Legacy v1 region packet support only. New wire grid: config/vest.json.
VEST_REGIONS=upper-left,upper-right,middle-left,middle-right,lower-left,lower-right
HIT_FUTURE_TOLERANCE_SECONDS=5

# Separate interactive simulator website (python simulator_web.py)
SIMULATOR_HOST=127.0.0.1
SIMULATOR_PORT=5001
MAIN_APP_URL=http://127.0.0.1:5000
UDP_TARGET_HOST=127.0.0.1
