# Local Flask server
APP_HOST=127.0.0.1
APP_PORT=5000

# PostgreSQL: fill in your own local database and login; no credentials included.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGCONNECT_TIMEOUT=3

# UDP bind address and port. Use 0.0.0.0 to listen on all laptop interfaces.
# Start the combined web/UDP app with python app.py (reloader disabled).
UDP_HOST=127.0.0.1
UDP_PORT=5005

# Single vest mapping: SVG positions follow this order, left-to-right then
# top-to-bottom. A final unpaired region spans the width. Confirm with hardware.
VEST_REGIONS=upper-left,upper-right,middle-left,middle-right,lower-left,lower-right
HIT_FUTURE_TOLERANCE_SECONDS=5
